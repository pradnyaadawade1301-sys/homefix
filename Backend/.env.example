# Database
DATABASE_URL=postgres://homefix:homefix_pass@localhost:5434/homefix?sslmode=disable

# Email OTP (signup verification) — free via Gmail SMTP.
# 1. Turn on 2-Step Verification on your Gmail account.
# 2. Google Account -> Security -> App passwords -> generate one for "Mail".
# 3. Put your Gmail address in SMTP_USER and the 16-char app password in SMTP_PASS
#    (NOT your normal Gmail login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pratikshayadav7777@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-gmail-address@gmail.com

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_HOURS=720

# Groq AI (get a free API key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# UPI Payment
UPI_PAYEE_VPA=homefixlive@okaxis
UPI_PAYEE_NAME=HomeFix Live

# Firebase Cloud Messaging (push notifications)
# Download your service account JSON from Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key
# Save it to ./secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=homefix-live

# File uploads
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8090

# WebRTC TURN server (coturn in docker-compose)
TURN_URL=turn:localhost:3478
TURN_SECRET=your-turn-secret
TURN_REALM=homefixlive.com
TURN_TTL_SECONDS=3600